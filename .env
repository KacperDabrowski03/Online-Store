# Skopiuj ten plik jako .env i ustaw własne hasła.
# Plik .env nie trafia do repozytorium (jest w .gitignore).

POSTGRES_DB=drukarnia
POSTGRES_USER=drukarnia
POSTGRES_PASSWORD=zmien-to-haslo
POSTGRES_PORT=5432

# opcjonalny pgAdmin: docker compose --profile narzedzia up -d
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=zmien-to-haslo

# Backend (zmienne środowiskowe przy uruchamianiu backendu, nie dla docker compose):
# JWT_SEKRET – klucz podpisu tokenów, co najmniej 32 znaki; w profilu dev opcjonalny
#              (brak = losowy klucz przy każdym starcie), w profilu prod wymagany.
